# Function to remove special characters



def normalize_name(name):
    # Normalize to remove accents and special characters
    name = unicodedata.normalize('NFD', name)
    # Encode to ASCII and ignore errors, then decode back to string
    name = name.encode('ascii', 'ignore').decode('utf-8')
    return name



#################################################
# Cleaning 2026 Data
#################################################

year = '2026'

for race in ['TOR330', 'TOR450']:
    df_output_folder = Path(f'{race} Data/1. 100x100trail/')
    df_file = f'{race}_2026.xlsx'

    athletes_info = []
    aid_station_info = []
    timestamp_info = []

    print('\n' + '=' * 60)
    print(f'Year: {year}')
    print(f'Race: {race}')
    print('=' * 60)

    ######################################################################
    # 2026 Demographics
    ######################################################################

    # Load the demographics JSON data
    with open(
        f'{race} Data/1. 100x100trail/JSON/{year} Data/{race}_{year}_dem.json',
        'r',
        encoding='utf-8'
    ) as file:

        data = json.load(file)

    # Extract athlete information
    for athlete in data["iscritti"]:

        athlete_dem = {
            "Name": f"{athlete['cognome']} {athlete['nome']}",
            "Bib": athlete["pettorale"],
            "Team": athlete["team"],
            "Category": athlete["categoria"],
            "Sex": athlete["sesso"],
            "Nationality": athlete["nazione"]
        }

        athletes_info.append(athlete_dem)

    # Create Demographics DataFrame
    dem_df = pd.DataFrame(
        athletes_info,
        columns=[
            'Name',
            'Bib',
            'Team',
            'Category',
            'Sex',
            'Nationality'
        ]
    )

    #################################################
    # Clean Athlete Names
    #################################################

    dem_df['Name'] = (
        dem_df['Name']
        .str.strip()
        .str.title()
        .str.replace(',', '', regex=False)
        .str.replace("'", ' ', regex=False)
        .str.replace('-', ' ', regex=False)
        .str.replace(r'\s+', ' ', regex=True)
        .str.strip()
        .apply(normalize_name)
    )

    #################################################
    # Add Race and Year
    #################################################

    dem_df['Race'] = race
    dem_df['Year'] = year

    #################################################
    # Clean Numerical Columns
    #################################################

    for num_column in ['Bib']:

        dem_df[num_column] = (
            dem_df[num_column]
            .astype('Int64')
            .astype('string')
        )

    #################################################
    # Clean Sex
    #################################################

    dem_df['Sex'] = (
        dem_df['Sex']
        .astype('string')
        .replace({
            'True': 'M',
            'False': 'F'
        })
    )

    #################################################
    # Clean Nationality
    #################################################

    dem_df['Nationality'] = (
        dem_df['Nationality']
        .str.strip()
        .str.upper()
    )

    #################################################
    # Display Demographics Data
    #################################################

    print('\n' + '*' * 20)
    print('Demographics Data')
    print('*' * 20)

    print(dem_df.head())
    print(f'\nTotal Records: {len(dem_df):,}')

    ######################################################################
    # 2026 Aid Station Data
    ######################################################################

    # Load the aid station JSON data
    with open(
        f'{race} Data/1. 100x100trail/JSON/{year} Data/{race}_{year}_aid_station.json',
        'r',
        encoding='utf-8'
    ) as file:

        data = json.load(file)

    # Extract aid station information
    for aid_station in data["postazioni"]:

        aid_station_details = {
            "Place": aid_station["text"],
            "Aid Station Rank": aid_station["rank"]
        }

        aid_station_info.append(aid_station_details)

    # Create Aid Station DataFrame
    aid_station_df = pd.DataFrame(
        aid_station_info,
        columns=[
            "Place",
            "Aid Station Rank"
        ]
    )

    #################################################
    # Clean Aid Station Names
    #################################################

    aid_station_df['Place'] = (
        aid_station_df['Place']
        .str.strip()
        .str.title()
        .str.replace(',', '', regex=False)
        .str.replace("'", ' ', regex=False)
        .str.replace('-', ' ', regex=False)
        .str.replace(r'\s+', ' ', regex=True)
        .str.strip()
        .apply(normalize_name)
    )

    #################################################
    # Clean Numerical Columns
    #################################################

    for num_column in ['Aid Station Rank']:

        aid_station_df[num_column] = (
            aid_station_df[num_column]
            .astype('Int64')
            .astype('string')
        )

    #################################################
    # Display Aid Station Data
    #################################################

    print('\n' + '*' * 20)
    print('Aid Station Data')
    print('*' * 20)

    print(aid_station_df.head())
    print(f'\nTotal Records: {len(aid_station_df):,}')

    ######################################################################
    # 2026 Timestamp Data
    ######################################################################

    # Load the timestamp JSON data
    with open(
        f'{race} Data/1. 100x100trail/JSON/{year} Data/{race}_{year}_timestamp.json',
        'r',
        encoding='utf-8'
    ) as file:

        data = json.load(file)

    #################################################
    # Extract Timestamp Information
    #################################################

    for block in data:

        for athlete in block["result"]:

            bib_number = athlete["bib"]
            rankposition = athlete["posizione"]
            aid_station_number = athlete["postazione"]
            status_number = athlete["status"]

            for crono in athlete.get("crono", []):

                timestamp_details = {
                    "Bib": bib_number,
                    "Rank Position": rankposition,
                    "Aid Station Number": aid_station_number,
                    "Status": status_number,
                    "Aid Station Rank": crono["postazione"],
                    "Time": crono["tempo"]
                }

                timestamp_info.append(timestamp_details)

    #################################################
    # Create Timestamp DataFrame
    #################################################

    timestamp_df = pd.DataFrame(
        timestamp_info,
        columns=[
            'Bib',
            'Rank Position',
            'Aid Station Number',
            'Status',
            'Aid Station Rank',
            'Time'
        ]
    )

    #################################################
    # Clean Numerical Columns
    #################################################

    numerical_columns = [
        'Bib',
        'Aid Station Rank',
        'Status',
        'Rank Position',
        'Aid Station Number'
    ]

    for num_column in numerical_columns:

        timestamp_df[num_column] = (
            timestamp_df[num_column]
            .astype('Int64')
            .astype('string')
        )

    #################################################
    # Clean Status
    #################################################

    timestamp_df['Status'] = (
        timestamp_df['Status']
        .replace({
            '195': 'FALSE',
            '194': 'TRUE'
        })
    )

    #################################################
    # Display Timestamp Data
    #################################################

    print('\n' + '*' * 20)
    print('Timestamp Data')
    print('*' * 20)

    print(timestamp_df.head())
    print(f'\nTotal Records: {len(timestamp_df):,}')

    #################################################
    # Race Processing Summary
    #################################################

    print('\n' + '=' * 60)
    print(f'{race} - {year} Processing Complete')
    print('=' * 60)

    print(f'Demographics Records: {len(dem_df):,}')
    print(f'Aid Station Records:  {len(aid_station_df):,}')
    print(f'Timestamp Records:    {len(timestamp_df):,}')

    ######################################################################
    # 2025 Combining datasets
    ######################################################################



    df_output_folder = Path(f'{race} Data/1. 100x100trail/')

    df_file = f'{race}_2026.xlsx'
    df_output_path = df_output_folder / df_file

    # Merge Step 1: Aid Station + Timestamp Data
    aid_station_timestamp = pd.merge(
        aid_station_df,
        timestamp_df,
        on="Aid Station Rank",
        how="left"
    )

    # Merge Step 2: Add Demographics Data
    df = pd.merge(
        aid_station_timestamp,
        dem_df,
        on="Bib",
        how="left"
    )

    # Display Data
    print(df.tail())
    print(f'Total Records: {len(df):,}')

    # Export to Excel
    df.to_excel(
        df_output_path,
        index=False
    )

    print(f'SUCCESS: Data saved to {df_output_path}')

